# Hive 开源骨架 — 环境变量模板
#
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，绝不提交。
# 生产版所有敏感配置均通过环境变量注入，仓库内无任何硬编码凭据。

# ── 服务 ────────────────────────────────────────────────
HIVE_HOST=127.0.0.1
HIVE_PORT=8764

# ── 安全 ────────────────────────────────────────────────
# 首次启动的 Master API Key（务必替换为强随机值）
HIVE_MASTER_KEY=replace-with-strong-master-key

# ── 记忆底座 ────────────────────────────────────────────
SUPERMEM_BASE_URL=http://127.0.0.1:8765
SUPERMEM_TOKEN=

# ── 存储与日志 ──────────────────────────────────────────
HIVE_DB_PATH=./data/hive.db
HIVE_LOG_LEVEL=INFO

# ── 通信 ────────────────────────────────────────────────
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
INBOX_POLL_TIMEOUT=25
MESSAGE_TTL=86400

# ── 自愈 ────────────────────────────────────────────────
FAILURE_THRESHOLD=3
